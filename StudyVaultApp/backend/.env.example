PORT=8787
WESH_ALRAY_DATA_FILE=/tmp/wesh-alray-store.json
WESH_ALRAY_BACKUP_DIR=/tmp/wesh-alray-backups
CORS_ORIGIN=http://localhost:8787
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WESH_ALRAY_API_TOKEN=replace-with-development-token
WESH_ALRAY_BLOCKED_CLIENT_HASHES=

# Public web sharing and Universal Links.
# Set WESH_ALRAY_PUBLIC_WEB_BASE_URL to the production HTTPS origin that serves this backend.
# Set APPLE_APP_SITE_APP_ID to TEAMID.bundle-id, for example 4HM66AD594.com.shary17454.esal.
WESH_ALRAY_PUBLIC_WEB_BASE_URL=https://example.com
APPLE_APP_SITE_APP_ID=TEAMID.com.shary17454.esal

# Optional AI provider configuration. Keep provider keys on the backend only.
# local = deterministic local rules, openai = OpenAI Responses API with local fallback.
AI_PROVIDER=local
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_CONTEXT_ITEMS=50
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-with-secret-in-runtime-only

# Optional APNs provider configuration for production push dispatch.
# Store the .p8 private key as base64 text in the runtime secret manager only.
APNS_ENV=sandbox
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.shary17454.esal
# APNS_PRIVATE_KEY_BASE64=replace-with-secret-in-runtime-only
