# OS and editor files
.DS_Store
._*
Thumbs.db
*.swp
*.tmp

# Local Codex/session state
.codex/
.agents/
tmp/
work/

# Secrets and signing/private material
.env
.env.*
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
*.cer
*.p12

# Python/local generated files
vendor/
data/raw_text/
data/extracted/
__pycache__/
.pycache-check/
*.pyc

# Flutter/Dart generated files
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/ephemeral/

# Node/local caches
node_modules/

# Xcode build output and local state
DerivedData/
build/
Archives/
Exported/
**/DerivedData/
ios/**/DerivedData/
**/*.xcarchive/
**/*.ipa
**/*.dSYM/
**/*.dSYM.zip
**/ArchiveIntermediates/
**/ModuleCache.noindex/
**/Intermediates.noindex/
xcuserdata/
**/xcuserdata/
*.xcuserstate
*.xccheckout
*.moved-aside

# Native dependency folders and generated caches
**/Pods/
**/.gradle/
**/local.properties

# Packaged snapshots generated during development
*.zip

# SQLite sidecar files
data/*.sqlite-shm
data/*.sqlite-wal

# Logs
*.log

# BatalAlDroob App Store build keeps searchable catalog data in-app.
# Original PDF catalog packs stay outside the submitted app bundle.
ios/BatalAlDroob/BatalAlDroob/Web/**/*.pdf
