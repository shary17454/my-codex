# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp

# Local Codex/session state
.codex/
.agents/
tmp/
work/

# Python/local generated files
vendor/
data/raw_text/
data/extracted/
__pycache__/
.pycache-check/
*.py[cod]

# Flutter/Dart generated files
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/ephemeral/

# Native dependency folders and generated caches
**/Pods/
**/DerivedData/
ios/**/DerivedData/
**/*.xcuserstate
**/xcuserdata/
**/.gradle/
**/local.properties

# Build outputs and archives generated during local sessions
outputs/
build/
**/*.xcarchive/
**/*.ipa
**/*.dSYM/
**/ArchiveIntermediates/
**/ModuleCache.noindex/

# SQLite sidecar files
data/*.sqlite-shm
data/*.sqlite-wal

# Logs
*.log

# BatalAlDroob App Store build keeps searchable catalog data in-app.
# Original PDF catalog packs stay outside the submitted app bundle.
ios/BatalAlDroob/BatalAlDroob/Web/**/*.pdf
