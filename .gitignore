# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*.temp
*.bak
*.orig

# Local Codex/session state
.codex/
.agents/
tmp/
work/

# Python/local generated files
vendor/
data/raw_text/
data/extracted/
__pycache__/
.pycache-check/
*.py[cod]

# Flutter/Dart generated files
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/ephemeral/
.dart_tool/

# Native dependency folders and generated caches
**/Pods/
**/DerivedData/
ios/**/DerivedData/
DerivedData/
**/*.xcuserstate
**/xcuserdata/
**/.swiftpm/
**/SourcePackages/
**/.build/
**/*.xcresult/
**/*.moved-aside
**/*.hmap
**/*.ipa
**/*.dSYM.zip
**/.gradle/
**/local.properties

# Node/web generated folders
node_modules/
**/node_modules/
.next/
dist/
coverage/

# Build outputs and archives generated during local sessions
outputs/
build/
**/*.xcarchive/
**/*.ipa
**/*.dSYM/
**/ArchiveIntermediates/
**/ModuleCache.noindex/

# SQLite sidecar files
data/*.sqlite-shm
data/*.sqlite-wal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local secrets and machine-specific config
.env
.env.*
!.env.example

# BatalAlDroob App Store build keeps searchable catalog data in-app.
# Original PDF catalog packs stay outside the submitted app bundle.
ios/BatalAlDroob/BatalAlDroob/Web/**/*.pdf
